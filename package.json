  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.1",
    "adm-zip": "^0.5.16",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260915.1",
    "@types/adm-zip": "^0.5.7",
